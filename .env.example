# Optional settings. Copy to .env, edit, then load with:  set -a; source .env; set +a
# .env is git-ignored. Never commit a real token.

# Hugging Face: not needed for this ungated model; set it only to avoid download rate limits
HF_TOKEN=
# Where model weights are cached (shared by the training and serving environments)
HF_HOME=~/.cache/huggingface

# scripts/serve.sh
BASE=Qwen/Qwen3-4B-Instruct-2507
ADAPTERS="sroie-r8=outputs/lora-r8 sroie-r16=outputs/lora-r16 sroie-r32=outputs/lora-r32"
# Extra vLLM flags; --dtype half is needed on GPUs without bf16 (e.g. T4)
EXTRA_ARGS="--dtype half"

# Allow loading/unloading adapters while the server runs (trusted environments only)
VLLM_ALLOW_RUNTIME_LORA_UPDATING=False
